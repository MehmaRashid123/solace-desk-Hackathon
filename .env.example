# Copy to /server/.env — never commit real secrets.

# Postgres
DATABASE_URL="postgresql://lumen:lumen@localhost:5433/lumen?schema=public"

# JWT (access + refresh). Also accepted as JWT_SECRET if you alias it.
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# API
CLIENT_ORIGIN="http://localhost:3000"
PORT=4000
NODE_ENV="development"

# AI — server only. Leave empty for keyword fallback.
# Use OPENAI_API_KEY and/or ANTHROPIC_API_KEY (AI_API_KEY is not read).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_TIMEOUT_MS=8000

# Email / SMTP (Optional - leave empty for console previews during development)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Solace Support <support@solacedesk.dev>"
APP_BASE_URL="http://localhost:3000"

# Redis Cache & Queue (Optional - defaults to in-memory fallback if empty)
REDIS_URL="redis://localhost:6379"
